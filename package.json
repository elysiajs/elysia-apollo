{
    "name": "@elysia/apollo",
    "description": "Elysia plugin to integrate GraphQL Apollo",
    "version": "2.0.0-beta.1",
    "author": {
        "name": "saltyAom",
        "url": "https://github.com/SaltyAom",
        "email": "saltyaom@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/elysiajs/elysia-apollo"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "bugs": "https://github.com/elysiajs/elysia-apollo/issues",
    "homepage": "https://github.com/elysiajs/elysia-apollo",
    "keywords": [
        "elysia",
        "apollo",
        "graphql"
    ],
    "license": "MIT",
    "scripts": {
        "dev": "bun run --watch example/index.ts",
        "test": "bun test && npm run test:node",
        "test:node": "npm install --prefix ./test/node/cjs/ && npm install --prefix ./test/node/esm/ && node ./test/node/cjs/index.js && node ./test/node/esm/index.js",
        "build": "bun build.ts",
        "release": "npm run build && npm run test && npm publish --access public"
    },
    "dependencies": {
        "@apollo/server": "^5.5.1",
        "@apollo/server-plugin-landing-page-graphql-playground": "^4.0.1",
        "graphql": "^17.0.1",
        "graphql-tag": "^2.12.7",
        "valibot": "^1.4.2"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "elysia": "2.0.0-beta.1",
        "eslint": "9.6.0",
        "tsdown": "^0.22.3",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "elysia": ">= 2.0.0-beta.1"
    },
    "peerDependenciesMeta": {
        "@apollo/server-plugin-landing-page-graphql-playground": {
            "optional": true
        },
        "@apollo/server": {
            "optional": true
        },
        "graphql": {
            "optional": true
        },
        "graphql-tag": {
            "optional": true
        }
    }
}